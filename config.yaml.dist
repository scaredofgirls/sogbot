bot:
  # CRITICAL: 50, ERROR 40, WARNING 30, INFO 20, DEBUG 10
  log_level: 20
  # Which extentions to load and which guilds should have access to them
  # module.name: [guild_ids]
  # An empty list means all guilds the bot logs into can use the command
  extentions:
    admin.admin: []
    iom.iom: []
    rand.rand: []
    imgur.user_watcher: []
    mc.rcon: []
  owner_ids:
    - 999999999999999999
  default_guild_ids: 8888888888

storage:
  shelve:
    db_path: "disc_bot.db"

discord:
  bot_token: blahblah.eat.pizza

bnet:
  client_id: 6ea7f264d0f65ba49308fa3e2d72289b
  client_secret: d756dfbf3525f0bcfeb1ecd67d1db8e66d3cb2c5
  uri_base: https://us.api.blizzard.com/data/wow

imgur:
  client_id: 6ea7f264d0f65ba49308fa3e2d72289b
  client_secret: d756dfbf3525f0bcfeb1ecd67d1db8e66d3cb2c5
  api:
    base: https://api.imgur.com/3
    subs: account/{0}/submissions/0/newest

